// SurakshaMesh removable lid
// Rounded lid with nested skirt, continuous compression bead, recessed fasteners, and label fields.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import unitBox from "unit_box.kcl"
import unitCylinder from "unit_cylinder.kcl"
import * from "parameters.kcl"

lidPlatePlane = {
  origin = [0mm, 0mm, -0.75mm],
  xAxis = [1, 0, 0],
  yAxis = [0, 1, 0]
}
lidOuterProfile = sketch(on = lidPlatePlane) {
  top = line(start = [var 49mm, var 40mm], end = [var -49mm, var 40mm])
  topLeft = arc(start = [var -49mm, var 40mm], end = [var -60mm, var 29mm], center = [var -49mm, var 29mm])
  left = line(start = [var -60mm, var 29mm], end = [var -60mm, var -29mm])
  bottomLeft = arc(start = [var -60mm, var -29mm], end = [var -49mm, var -40mm], center = [var -49mm, var -29mm])
  bottom = line(start = [var -49mm, var -40mm], end = [var 49mm, var -40mm])
  bottomRight = arc(start = [var 49mm, var -40mm], end = [var 60mm, var -29mm], center = [var 49mm, var -29mm])
  right = line(start = [var 60mm, var -29mm], end = [var 60mm, var 29mm])
  topRight = arc(start = [var 60mm, var 29mm], end = [var 49mm, var 40mm], center = [var 49mm, var 29mm])
  coincident([top.end, topLeft.start])
  coincident([topLeft.end, left.start])
  coincident([left.end, bottomLeft.start])
  coincident([bottomLeft.end, bottom.start])
  coincident([bottom.end, bottomRight.start])
  coincident([bottomRight.end, right.start])
  coincident([right.end, topRight.start])
  coincident([topRight.end, top.start])
  horizontal(top)
  vertical(left)
  horizontal(bottom)
  vertical(right)
  vertical([topLeft.center, topLeft.start])
  horizontal([topLeft.center, topLeft.end])
  horizontal([bottomLeft.center, bottomLeft.start])
  vertical([bottomLeft.center, bottomLeft.end])
  vertical([bottomRight.center, bottomRight.start])
  horizontal([bottomRight.center, bottomRight.end])
  horizontal([topRight.center, topRight.start])
  vertical([topRight.center, topRight.end])
  horizontal([topLeft.center, topRight.center])
  horizontal([bottomLeft.center, bottomRight.center])
  vertical([topLeft.center, bottomLeft.center])
  vertical([topRight.center, bottomRight.center])
  radius(topLeft) == outerCornerRadius
  radius(bottomLeft) == outerCornerRadius
  radius(bottomRight) == outerCornerRadius
  radius(topRight) == outerCornerRadius
  horizontalDistance([topLeft.center, topRight.center]) == outerLength - 2 * outerCornerRadius
  verticalDistance([bottomRight.center, topRight.center]) == outerWidth - 2 * outerCornerRadius
  horizontalDistance([ORIGIN, topRight.center]) == outerLength / 2 - outerCornerRadius
  verticalDistance([ORIGIN, topRight.center]) == outerWidth / 2 - outerCornerRadius
}
lidOuterRegion = region(segments = [lidOuterProfile.top, lidOuterProfile.topLeft], intersectionIndex = -1, direction = CCW)
lidPlate = extrude(lidOuterRegion, length = lidPlateThickness)

skirtPlane = {
  origin = [0mm, 0mm, -4.25mm],
  xAxis = [1, 0, 0],
  yAxis = [0, 1, 0]
}
skirtOuterProfile = sketch(on = skirtPlane) {
  top = line(start = [var 49mm, var 32.6mm], end = [var -49mm, var 32.6mm])
  topLeft = arc(start = [var -49mm, var 32.6mm], end = [var -52.6mm, var 29mm], center = [var -49mm, var 29mm])
  left = line(start = [var -52.6mm, var 29mm], end = [var -52.6mm, var -29mm])
  bottomLeft = arc(start = [var -52.6mm, var -29mm], end = [var -49mm, var -32.6mm], center = [var -49mm, var -29mm])
  bottom = line(start = [var -49mm, var -32.6mm], end = [var 49mm, var -32.6mm])
  bottomRight = arc(start = [var 49mm, var -32.6mm], end = [var 52.6mm, var -29mm], center = [var 49mm, var -29mm])
  right = line(start = [var 52.6mm, var -29mm], end = [var 52.6mm, var 29mm])
  topRight = arc(start = [var 52.6mm, var 29mm], end = [var 49mm, var 32.6mm], center = [var 49mm, var 29mm])
  coincident([top.end, topLeft.start])
  coincident([topLeft.end, left.start])
  coincident([left.end, bottomLeft.start])
  coincident([bottomLeft.end, bottom.start])
  coincident([bottom.end, bottomRight.start])
  coincident([bottomRight.end, right.start])
  coincident([right.end, topRight.start])
  coincident([topRight.end, top.start])
  horizontal(top)
  vertical(left)
  horizontal(bottom)
  vertical(right)
  vertical([topLeft.center, topLeft.start])
  horizontal([topLeft.center, topLeft.end])
  horizontal([bottomLeft.center, bottomLeft.start])
  vertical([bottomLeft.center, bottomLeft.end])
  vertical([bottomRight.center, bottomRight.start])
  horizontal([bottomRight.center, bottomRight.end])
  horizontal([topRight.center, topRight.start])
  vertical([topRight.center, topRight.end])
  horizontal([topLeft.center, topRight.center])
  horizontal([bottomLeft.center, bottomRight.center])
  vertical([topLeft.center, bottomLeft.center])
  vertical([topRight.center, bottomRight.center])
  radius(topLeft) == lidSkirtOuterRadius
  radius(bottomLeft) == lidSkirtOuterRadius
  radius(bottomRight) == lidSkirtOuterRadius
  radius(topRight) == lidSkirtOuterRadius
  horizontalDistance([topLeft.center, topRight.center]) == lidSkirtOuterLength - 2 * lidSkirtOuterRadius
  verticalDistance([bottomRight.center, topRight.center]) == lidSkirtOuterWidth - 2 * lidSkirtOuterRadius
  horizontalDistance([ORIGIN, topRight.center]) == lidSkirtOuterLength / 2 - lidSkirtOuterRadius
  verticalDistance([ORIGIN, topRight.center]) == lidSkirtOuterWidth / 2 - lidSkirtOuterRadius
}
skirtOuterRegion = region(segments = [skirtOuterProfile.top, skirtOuterProfile.topLeft], intersectionIndex = -1, direction = CCW)
skirtOuterSolid = extrude(skirtOuterRegion, length = lidSkirtDepth + 0.2mm)

skirtInnerProfile = sketch(on = skirtPlane) {
  top = line(start = [var 49mm, var 30.4mm], end = [var -49mm, var 30.4mm])
  topLeft = arc(start = [var -49mm, var 30.4mm], end = [var -50.4mm, var 29mm], center = [var -49mm, var 29mm])
  left = line(start = [var -50.4mm, var 29mm], end = [var -50.4mm, var -29mm])
  bottomLeft = arc(start = [var -50.4mm, var -29mm], end = [var -49mm, var -30.4mm], center = [var -49mm, var -29mm])
  bottom = line(start = [var -49mm, var -30.4mm], end = [var 49mm, var -30.4mm])
  bottomRight = arc(start = [var 49mm, var -30.4mm], end = [var 50.4mm, var -29mm], center = [var 49mm, var -29mm])
  right = line(start = [var 50.4mm, var -29mm], end = [var 50.4mm, var 29mm])
  topRight = arc(start = [var 50.4mm, var 29mm], end = [var 49mm, var 30.4mm], center = [var 49mm, var 29mm])
  coincident([top.end, topLeft.start])
  coincident([topLeft.end, left.start])
  coincident([left.end, bottomLeft.start])
  coincident([bottomLeft.end, bottom.start])
  coincident([bottom.end, bottomRight.start])
  coincident([bottomRight.end, right.start])
  coincident([right.end, topRight.start])
  coincident([topRight.end, top.start])
  horizontal(top)
  vertical(left)
  horizontal(bottom)
  vertical(right)
  vertical([topLeft.center, topLeft.start])
  horizontal([topLeft.center, topLeft.end])
  horizontal([bottomLeft.center, bottomLeft.start])
  vertical([bottomLeft.center, bottomLeft.end])
  vertical([bottomRight.center, bottomRight.start])
  horizontal([bottomRight.center, bottomRight.end])
  horizontal([topRight.center, topRight.start])
  vertical([topRight.center, topRight.end])
  horizontal([topLeft.center, topRight.center])
  horizontal([bottomLeft.center, bottomRight.center])
  vertical([topLeft.center, bottomLeft.center])
  vertical([topRight.center, bottomRight.center])
  radius(topLeft) == lidSkirtInnerRadius
  radius(bottomLeft) == lidSkirtInnerRadius
  radius(bottomRight) == lidSkirtInnerRadius
  radius(topRight) == lidSkirtInnerRadius
  horizontalDistance([topLeft.center, topRight.center]) == lidSkirtInnerLength - 2 * lidSkirtInnerRadius
  verticalDistance([bottomRight.center, topRight.center]) == lidSkirtInnerWidth - 2 * lidSkirtInnerRadius
  horizontalDistance([ORIGIN, topRight.center]) == lidSkirtInnerLength / 2 - lidSkirtInnerRadius
  verticalDistance([ORIGIN, topRight.center]) == lidSkirtInnerWidth / 2 - lidSkirtInnerRadius
}
skirtInnerRegion = region(segments = [skirtInnerProfile.top, skirtInnerProfile.topLeft], intersectionIndex = -1, direction = CCW)
skirtInnerCutter = extrude(skirtInnerRegion, length = lidSkirtDepth + 2 * csgOverlap)
lidSkirt = subtract([skirtOuterSolid], tools = [skirtInnerCutter])

beadPlane = {
  origin = [0mm, 0mm, -1.35mm],
  xAxis = [1, 0, 0],
  yAxis = [0, 1, 0]
}
beadOuterProfile = sketch(on = beadPlane) {
  top = line(start = [var 49mm, var 35.9mm], end = [var -49mm, var 35.9mm])
  topLeft = arc(start = [var -49mm, var 35.9mm], end = [var -55.9mm, var 29mm], center = [var -49mm, var 29mm])
  left = line(start = [var -55.9mm, var 29mm], end = [var -55.9mm, var -29mm])
  bottomLeft = arc(start = [var -55.9mm, var -29mm], end = [var -49mm, var -35.9mm], center = [var -49mm, var -29mm])
  bottom = line(start = [var -49mm, var -35.9mm], end = [var 49mm, var -35.9mm])
  bottomRight = arc(start = [var 49mm, var -35.9mm], end = [var 55.9mm, var -29mm], center = [var 49mm, var -29mm])
  right = line(start = [var 55.9mm, var -29mm], end = [var 55.9mm, var 29mm])
  topRight = arc(start = [var 55.9mm, var 29mm], end = [var 49mm, var 35.9mm], center = [var 49mm, var 29mm])
  coincident([top.end, topLeft.start])
  coincident([topLeft.end, left.start])
  coincident([left.end, bottomLeft.start])
  coincident([bottomLeft.end, bottom.start])
  coincident([bottom.end, bottomRight.start])
  coincident([bottomRight.end, right.start])
  coincident([right.end, topRight.start])
  coincident([topRight.end, top.start])
  horizontal(top)
  vertical(left)
  horizontal(bottom)
  vertical(right)
  vertical([topLeft.center, topLeft.start])
  horizontal([topLeft.center, topLeft.end])
  horizontal([bottomLeft.center, bottomLeft.start])
  vertical([bottomLeft.center, bottomLeft.end])
  vertical([bottomRight.center, bottomRight.start])
  horizontal([bottomRight.center, bottomRight.end])
  horizontal([topRight.center, topRight.start])
  vertical([topRight.center, topRight.end])
  horizontal([topLeft.center, topRight.center])
  horizontal([bottomLeft.center, bottomRight.center])
  vertical([topLeft.center, bottomLeft.center])
  vertical([topRight.center, bottomRight.center])
  radius(topLeft) == compressionBeadOuterRadius
  radius(bottomLeft) == compressionBeadOuterRadius
  radius(bottomRight) == compressionBeadOuterRadius
  radius(topRight) == compressionBeadOuterRadius
  horizontalDistance([topLeft.center, topRight.center]) == compressionBeadOuterLength - 2 * compressionBeadOuterRadius
  verticalDistance([bottomRight.center, topRight.center]) == compressionBeadOuterWidth - 2 * compressionBeadOuterRadius
  horizontalDistance([ORIGIN, topRight.center]) == compressionBeadOuterLength / 2 - compressionBeadOuterRadius
  verticalDistance([ORIGIN, topRight.center]) == compressionBeadOuterWidth / 2 - compressionBeadOuterRadius
}
beadOuterRegion = region(segments = [beadOuterProfile.top, beadOuterProfile.topLeft], intersectionIndex = -1, direction = CCW)
beadOuterSolid = extrude(beadOuterRegion, length = compressionBeadHeight + 0.1mm)

beadInnerProfile = sketch(on = beadPlane) {
  top = line(start = [var 49mm, var 35.1mm], end = [var -49mm, var 35.1mm])
  topLeft = arc(start = [var -49mm, var 35.1mm], end = [var -55.1mm, var 29mm], center = [var -49mm, var 29mm])
  left = line(start = [var -55.1mm, var 29mm], end = [var -55.1mm, var -29mm])
  bottomLeft = arc(start = [var -55.1mm, var -29mm], end = [var -49mm, var -35.1mm], center = [var -49mm, var -29mm])
  bottom = line(start = [var -49mm, var -35.1mm], end = [var 49mm, var -35.1mm])
  bottomRight = arc(start = [var 49mm, var -35.1mm], end = [var 55.1mm, var -29mm], center = [var 49mm, var -29mm])
  right = line(start = [var 55.1mm, var -29mm], end = [var 55.1mm, var 29mm])
  topRight = arc(start = [var 55.1mm, var 29mm], end = [var 49mm, var 35.1mm], center = [var 49mm, var 29mm])
  coincident([top.end, topLeft.start])
  coincident([topLeft.end, left.start])
  coincident([left.end, bottomLeft.start])
  coincident([bottomLeft.end, bottom.start])
  coincident([bottom.end, bottomRight.start])
  coincident([bottomRight.end, right.start])
  coincident([right.end, topRight.start])
  coincident([topRight.end, top.start])
  horizontal(top)
  vertical(left)
  horizontal(bottom)
  vertical(right)
  vertical([topLeft.center, topLeft.start])
  horizontal([topLeft.center, topLeft.end])
  horizontal([bottomLeft.center, bottomLeft.start])
  vertical([bottomLeft.center, bottomLeft.end])
  vertical([bottomRight.center, bottomRight.start])
  horizontal([bottomRight.center, bottomRight.end])
  horizontal([topRight.center, topRight.start])
  vertical([topRight.center, topRight.end])
  horizontal([topLeft.center, topRight.center])
  horizontal([bottomLeft.center, bottomRight.center])
  vertical([topLeft.center, bottomLeft.center])
  vertical([topRight.center, bottomRight.center])
  radius(topLeft) == compressionBeadInnerRadius
  radius(bottomLeft) == compressionBeadInnerRadius
  radius(bottomRight) == compressionBeadInnerRadius
  radius(topRight) == compressionBeadInnerRadius
  horizontalDistance([topLeft.center, topRight.center]) == compressionBeadInnerLength - 2 * compressionBeadInnerRadius
  verticalDistance([bottomRight.center, topRight.center]) == compressionBeadInnerWidth - 2 * compressionBeadInnerRadius
  horizontalDistance([ORIGIN, topRight.center]) == compressionBeadInnerLength / 2 - compressionBeadInnerRadius
  verticalDistance([ORIGIN, topRight.center]) == compressionBeadInnerWidth / 2 - compressionBeadInnerRadius
}
beadInnerRegion = region(segments = [beadInnerProfile.top, beadInnerProfile.topLeft], intersectionIndex = -1, direction = CCW)
beadInnerCutter = extrude(beadInnerRegion, length = compressionBeadHeight + 2 * csgOverlap)
compressionBead = subtract([beadOuterSolid], tools = [beadInnerCutter])

lidBlank = union([lidPlate, lidSkirt, compressionBead])

clearanceCutterBase = clone(unitCylinder)
  |> scale(x = screwClearanceDiameter / 1mm, y = screwClearanceDiameter / 1mm, z = 10mm / 1mm, global = true)
  |> translate(x = -screwCenterX, y = -screwCenterY, z = 0mm, global = true)
clearanceCutterFrontRight = clone(clearanceCutterBase)
  |> translate(x = 2 * screwCenterX, global = true)
clearanceCutterBackLeft = clone(clearanceCutterBase)
  |> translate(y = 2 * screwCenterY, global = true)
clearanceCutterBackRight = clone(clearanceCutterFrontRight)
  |> translate(y = 2 * screwCenterY, global = true)

counterboreCenterZ = 4.25mm - screwCounterboreDepth / 2 + 0.15mm
counterboreCutterBase = clone(unitCylinder)
  |> scale(x = screwCounterboreDiameter / 1mm, y = screwCounterboreDiameter / 1mm, z = (screwCounterboreDepth + 0.3mm) / 1mm, global = true)
  |> translate(x = -screwCenterX, y = -screwCenterY, z = counterboreCenterZ, global = true)
counterboreCutterFrontRight = clone(counterboreCutterBase)
  |> translate(x = 2 * screwCenterX, global = true)
counterboreCutterBackLeft = clone(counterboreCutterBase)
  |> translate(y = 2 * screwCenterY, global = true)
counterboreCutterBackRight = clone(counterboreCutterFrontRight)
  |> translate(y = 2 * screwCenterY, global = true)

mainLabelPocket = clone(unitBox)
  |> scale(x = 70mm / 1mm, y = 26mm / 1mm, z = 0.9mm / 1mm, global = true)
  |> translate(x = -5mm, y = 3mm, z = 4mm, global = true)
nodeLabelPocket = clone(unitBox)
  |> scale(x = 22mm / 1mm, y = 8mm / 1mm, z = 0.9mm / 1mm, global = true)
  |> translate(x = 35mm, y = -19mm, z = 4mm, global = true)

lidCut = subtract(
  [lidBlank],
  tools = [
    clearanceCutterBase,
    clearanceCutterFrontRight,
    clearanceCutterBackLeft,
    clearanceCutterBackRight,
    counterboreCutterBase,
    counterboreCutterFrontRight,
    counterboreCutterBackLeft,
    counterboreCutterBackRight,
    mainLabelPocket,
    nodeLabelPocket
  ],
)

constructionHidden = hide([
  lidOuterProfile,
  skirtOuterProfile,
  skirtInnerProfile,
  beadOuterProfile,
  beadInnerProfile
])

export enclosureLid = appearance(lidCut, color = lidColor, metalness = 16, roughness = 50)
